{
  "telegram": {
    "enabled": true,
    "bot_token": "x",
    "allowed_chat_ids": [
      123456789
    ],
    "proxy_url": null
  },
  "feishu": {
    "enabled": false,
    "app_id": "cli_xxx",
    "app_secret": "xxx",
    "allowed_chat_ids": [],
    "allowed_open_ids": [],
    "reply_in_thread": true
  },
  "copilot": {
    "cli_command": "copilot",
    "model": "gpt-5-mini",
    "available_models": [],
    "timeout_seconds": 3600,
    "allow_all_tools": true,
    "allow_all_paths": false,
    "add_workspace_dir": true,
    "additional_allowed_dirs": [],
    "reasoning_effort": null,
    "forward_reasoning": true
  },
  "runtime": {
    "workspace_root": "~/.topilot/workspace",
    "session_watch_interval_seconds": 2.0
  },
  "storage": {
    "chat_db_path": "~/.topilot/data/chats.json",
    "session_db_path": "~/.topilot/data/sessions.json",
    "log_file_path": "~/.topilot/logs/app.log"
  },
  "logging": {
    "log_level": "INFO",
    "console_log_level": "INFO",
    "httpx_log_level": "WARNING"
  }
}

# TELEGRAM_BOT_TOKEN from @BotFather, 必填项
TELEGRAM_BOT_TOKEN=your_bot_token
# 允许访问的 Telegram Chat ID，多个用逗号分隔。留空代表允许所有 Chat ID 访问，强烈建议配置以保证安全
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# 如果需要使用代理访问 Telegram API，需要设置代理 URL，例如 http://127.0.0.1:10808
TELEGRAM_PROXY_URL=http://127.0.0.1:10808
# Copilot CLI 的默认工作目录，留空则默认为命令执行目录
WORKSPACE_ROOT=~/copilot_telegram/workspace
# CHAT 数据库路径，存储聊天记录。留空则为WORKSPACE_ROOT/data/chats.json
CHAT_DB_PATH=~/copilot_telegram/config/chats.json
# SESSION 数据库路径，存储会话信息。留空则为WORKSPACE_ROOT/data/sessions.json
SESSION_DB_PATH=~/copilot_telegram/config/sessions.json
# 日志文件路径，默认 WORKSPACE_ROOT/logs/app.log
LOG_FILE_PATH=~/copilot_telegram/logs/app.log
# 文件日志级别（DEBUG/INFO/WARNING/ERROR），默认 INFO
LOG_LEVEL=INFO
# 控制台日志级别（DEBUG/INFO/WARNING/ERROR），默认 INFO
CONSOLE_LOG_LEVEL=INFO
# httpx 日志级别（建议 WARNING，避免轮询请求刷屏）
HTTPX_LOG_LEVEL=WARNING
# Copilot CLI 启动命令。留空则默认为copilot
COPILOT_CLI_COMMAND=copilot
# Copilot CLI 默认使用的模型，留空则默认为gpt-4.1
COPILOT_CLI_MODEL=gpt-4.1
# Copilot CLI 执行命令的超时时间（秒）。留空则默认为3600
COPILOT_CLI_TIMEOUT_SECONDS=3600
# 是否允许 Copilot CLI 使用所有工具，默认为true
COPILOT_CLI_ALLOW_ALL_TOOLS=true
# Copilot CLI 的推理程度 (low, medium, high, xhigh)，留空则默认自动。注意，部分模型可能无法配置该选项
COPILOT_CLI_REASONING_EFFORT=
# 是否启用 Copilot CLI 的前向推理功能
COPILOT_CLI_FORWARD_REASONING=true
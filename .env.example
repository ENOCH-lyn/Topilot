# TELEGRAM_BOT_TOKEN from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token
# 允许访问的 Telegram Chat ID，多个用逗号分隔
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# 如果需要使用代理访问 Telegram API，需要设置代理 URL，例如 http://127.0.0.1:10808
TELEGRAM_PROXY_URL=http://127.0.0.1:10808
# 工作空间根目录，Copilot CLI 将在此目录及其子目录中工作
WORKSPACE_ROOT=
# TASK 数据库路径，存储任务
TASK_DB_PATH=C:/Users/ENOCH/Desktop/tmp/copilot/data/tasks.json
# CHAT 数据库路径，存储聊天记录
CHAT_DB_PATH=C:/Users/ENOCH/Desktop/tmp/copilot/data/chats.json
# SESSION 数据库路径，存储会话信息
SESSION_DB_PATH=C:/Users/ENOCH/Desktop/tmp/copilot/data/sessions.json
# 是否启用 Copilot CLI 功能
COPILOT_CLI_ENABLED=true
# Copilot CLI 启动命令
COPILOT_CLI_COMMAND=copilot
# Copilot CLI 默认使用的模型
COPILOT_CLI_MODEL=gpt-5.3-codex
# Copilot CLI 执行命令的超时时间（秒）
COPILOT_CLI_TIMEOUT_SECONDS=120
# 是否允许 Copilot CLI 使用所有工具
COPILOT_CLI_ALLOW_ALL_TOOLS=true
# 是否在 Copilot CLI 命令中添加工作空间目录
COPILOT_CLI_ADD_WORKSPACE_DIR=true
# Copilot CLI 的推理程度 (low, medium, high)
COPILOT_CLI_REASONING_EFFORT=medium
# Copilot CLI 会话历史的轮数
COPILOT_CLI_HISTORY_TURNS=20
# 是否启用 Copilot CLI 的前向推理功能
COPILOT_CLI_FORWARD_REASONING=true
# Copilot CLI 推理结果的最大字符数，0 表示不限制
COPILOT_CLI_REASONING_MAX_CHARS=0
# 是否需要审批才能执行 shell 命令
APPROVAL_REQUIRED_FOR_SHELL=true
# shell 命令的超时时间（秒）
COMMAND_TIMEOUT_SECONDS=120
